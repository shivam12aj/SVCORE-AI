// ── ASK AI — via secure serverless proxy (no keys in browser) ──
async function askGemini(userMessage) { // Groq powered
  const msgs = conversationHistory.map(m => ({
    role: m.role === 'model' ? 'assistant' : 'user',
    content: m.parts[0].text
  }));
  msgs.push({ role: 'user', content: userMessage });
  if (msgs.length > 20) msgs.splice(0, msgs.length - 20);

  const genderTone = currentGender === 'female'
    ? 'Aap ek friendly, caring Indian ladki ki tarah baat karein — warm aur helpful tone mein.'
    : 'Aap ek confident, helpful Indian ladke ki tarah baat karein — friendly aur motivating tone mein.';

  const today = new Date();
  const days = ['Ravivar','Somvar','Mangalvar','Budhvar','Guruvar','Shukravar','Shanivar'];
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const dateStr = days[today.getDay()] + ', ' + today.getDate() + ' ' + months[today.getMonth()] + ' ' + today.getFullYear();
  const timeStr = today.getHours() + ':' + String(today.getMinutes()).padStart(2,'0');

  const systemPrompt = 'Tum SVCORE AI ho — Shivam Vishwakarma ka banaya Bharat ka pehla emotion-aware multilingual voice AI. ' + genderTone + ' Aaj ki date hai: ' + dateStr + ', aur time hai: ' + timeStr + '. Agar koi date ya time pooche to yahi seedha batao. ' +
    'Bahut natural aur warm Hinglish mein baat karo, jaise ek kareeb dost bol raha ho — bilkul voice conversation jaisa. ' +
    'Jawab SHORT aur SEEDHA rakho — sirf 2 se 4 sentences, bas utna hi jitna sawal ka jawab dene ke liye chahiye. Lambi lecture ya filler mat do. ' +
    'Koi bullet points, numbers, dashes, asterisk mat use karo — sirf smooth natural bolne wale sentences. Apna naam SVCORE AI hai.';

  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 14000);
    const res = await fetch('/.netlify/functions/groq', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: [{ role: 'system', content: systemPrompt }, ...msgs] }),
      signal: controller.signal
    });
    clearTimeout(timeout);
    const data = await res.json();

    if (data.reply) {
      conversationHistory.push({ role:'user', parts:[{text:userMessage}] });
      conversationHistory.push({ role:'model', parts:[{text:data.reply}] });
      if (conversationHistory.length > 20) conversationHistory = conversationHistory.slice(-20);
      return data.reply;
    }
    console.warn('Groq proxy error:', data.error);
    return 'Kuch samajh nahi aaya — dobara bolein 🙏';

  } catch(err) {
    console.warn('Groq proxy fetch error:', err.message);
    if (err.name === 'AbortError') return 'Thoda time lag raha hai — dobara try karein 🙏';
    return 'Network error — internet check karein 🌐';
  }
}

// ── EMOTION ──
function detectEmotion(text) {
  text = text.toLowerCase();
  if (/dukhi|sad|rona|pareshan|takleef|hurt|dard|akela|toot|fail|haar/.test(text)) return 'sad';
  if (/gussa|angry|frustrated|bakwaas|irritat/.test(text)) return 'angry';
  if (/khush|happy|mast|awesome|great|amazing|jeet/.test(text)) return 'happy';
  if (/darr|scared|afraid|nervous|anxious/.test(text)) return 'fear';
  if (/stressed|tension|ghabrana|worried|thak|pressure/.test(text)) return 'stress';
  return 'neutral';
}

