// ── VOICE INPUT ──
function startListen() {
  if (busy) return;
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { speak('Browser mein voice support nahi hai. Chrome use karein 🙏'); return; }

  busy = true;
  const btn = document.getElementById('micBtn');
  const ico = document.getElementById('mico');
  const lbl = document.getElementById('mlbl');
  const st  = document.getElementById('stxt');
  const wv  = document.getElementById('waves');

  btn.classList.add('go');
  ico.innerText = '⏹️';
  lbl.innerText = 'Sun raha...';
  st.innerText  = 'SVCORE AI sun raha hai — boliye...';
  wv.classList.add('on');

  const rec = new SR();
  rec.lang = curLang;
  rec.continuous = false;
  rec.interimResults = false;
  rec.maxAlternatives = 1;

  let resultReceived = false;

  rec.onresult = async (e) => {
    if (resultReceived) return;
    resultReceived = true;
    const inp  = e.results[0][0].transcript.trim();
    const emo  = detectEmotion(inp);
    st.innerText = '"' + inp + '"';
    wv.classList.remove('on');

    const local = getLocalReply(inp, emo);
    if (local) {
      speak(local);
      resetMic();
    } else {
      lbl.innerText = 'Soch raha...';
      ico.innerText = '🤔';
      st.innerText = 'Soch raha hoon...';
      const reply = await askGemini(inp);
      speak(reply || 'Dobara bolein dost 🙏');
      resetMic();
    }
  };

  rec.onend = () => {
    wv.classList.remove('on');
    if (!resultReceived) {
      st.innerText = 'Kuch sunai nahi diya — dobara bolein';
      resetMic();
    }
  };

  rec.onerror = (e) => {
    const msgs = {
      'no-speech'     :'Kuch sunai nahi diya — ek baar aur bolein 🎙️',
      'audio-capture' :'Microphone access nahi mila 🎤',
      'not-allowed'   :'Microphone permission denied 🔒',
      'network'       :'Network error — internet check karein 🌐'
    };
    const msg = msgs[e.error] || 'Kuch dikkat aayi — dobara bolein 🙏';
    st.innerText = msg;
    speak(msg);
    resetMic();
  };

  try { rec.start(); } catch(err) { console.error(err); resetMic(); }
}

// ── QUICK CHIPS ──
async function quickSay(text) {
  if (busy) return;
  busy = true;
  document.getElementById('stxt').innerText = '"' + text + '"';
  const emo   = detectEmotion(text);
  const local = getLocalReply(text, emo);
  if (local) {
    speak(local); resetMic();
  } else {
    document.getElementById('stxt').innerText = 'Soch raha hoon...';
    const reply = await askGemini(text);
    speak(reply || 'Maafi, dobara try karein 🙏');
    resetMic();
  }
}

