// ── VOICE LOADER ──
let voiceRetryCount = 0;
function loadVoices() {
  if (!window.speechSynthesis) return;
  const voices = window.speechSynthesis.getVoices();
  if (!voices || voices.length === 0) {
    if (voiceRetryCount < 25) { voiceRetryCount++; setTimeout(loadVoices, 300); }
    return;
  }
  allVoices = voices;
  populateVoiceSelector();
}

function populateVoiceSelector() {
  const sel = document.getElementById('voiceSel');
  if (!sel || allVoices.length === 0) return;
  sel.innerHTML = '';

  // Current gender ke hisab se filter karo
  const filtered = getVoicesForGender(currentGender);
  const showList = filtered.length > 0 ? filtered : allVoices;

  // Indian/Hindi voices pehle, baaki baad mein
  const indianLangs = ['hi','ta','te','bn','gu','mr','kn','ml','en-IN','en-GB'];
  const indianVoices = showList.filter(v => indianLangs.some(l => v.lang.startsWith(l)));
  const otherVoices  = showList.filter(v => !indianLangs.some(l => v.lang.startsWith(l)));
  const sortedList   = [...indianVoices, ...otherVoices];

  // Default Hindi/Indian voice auto-select
  let defaultIdx = -1;
  sortedList.forEach((v, i) => {
    const op = document.createElement('option');
    op.value = allVoices.indexOf(v);
    op.textContent = v.name + ' (' + v.lang + ')';
    if (defaultIdx === -1 && (v.lang.startsWith('hi') || v.lang === 'en-IN')) {
      defaultIdx = i;
      op.selected = true;
    }
    sel.appendChild(op);
  });

  const wrap = document.getElementById('voiceWrap');
  if (wrap && showList.length > 1) wrap.style.display = 'block';
}

// Gender ke hisab se voice filter
function getVoicesForGender(gender) {
  if (!allVoices.length) return [];

  // Google voices = best quality (Gemini/Assistant jaisi awaaz)
  const googleHindi = allVoices.filter(v => v.name.toLowerCase().includes('google') && v.lang.startsWith('hi'));
  const googleEnIN  = allVoices.filter(v => v.name.toLowerCase().includes('google') && v.lang === 'en-IN');
  const googleEn    = allVoices.filter(v => v.name.toLowerCase().includes('google') && v.lang.startsWith('en'));

  const femaleKeywords = ['female','woman','girl','zira','samantha','victoria','karen','moira','veena','tessa','fiona','susan','lekha','google hindi female'];
  const maleKeywords   = ['male','man','boy','david','daniel','rishi','google hindi male','deepa'];

  let googleMatched = [...googleHindi, ...googleEnIN, ...googleEn].filter(v => {
    const name = v.name.toLowerCase();
    if (gender === 'female') return !maleKeywords.some(k => name.includes(k));
    if (gender === 'male')   return !femaleKeywords.some(k => name.includes(k));
    return true;
  });

  let matched = allVoices.filter(v => {
    const name = v.name.toLowerCase();
    if (gender === 'female') return femaleKeywords.some(k => name.includes(k));
    if (gender === 'male')   return maleKeywords.some(k => name.includes(k));
    return false;
  });

  // Google voices pehle, baaki baad mein
  matched = [...googleMatched, ...matched.filter(v => !googleMatched.includes(v))];

  // Agar koi match nahi — Indian voices try karo
  if (matched.length === 0) {
    matched = allVoices.filter(v => v.lang.includes('IN') || v.lang.includes('in'));
  }

  return matched;
}

// Best voice for current gender
function getBestVoice() {
  if (!allVoices.length) return null;
  const candidates = getVoicesForGender(currentGender);
  if (candidates.length > 0) {
    // Manual selector ka value check karo
    const sel = document.getElementById('voiceSel');
    if (sel && sel.value !== '') {
      const v = allVoices[parseInt(sel.value)];
      if (v) return v;
    }
    return candidates[0];
  }
  return allVoices[0];
}

