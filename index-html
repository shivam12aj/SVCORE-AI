// ── SPEAK — Gender-aware, key-safe (calls /.netlify/functions/tts) ──
function speak(text, lang) {
  // Voice IDs — male/female
  const VOICE_MALE   = 'TxGEqnHWrfWFTfGW9XjX'; // Josh — deep natural male
  const VOICE_FEMALE = 'EXAVITQu4vr4xnSDxMaL'; // Bella — warm soft female
  const voiceId = currentGender === 'female' ? VOICE_FEMALE : VOICE_MALE;

  document.getElementById('resTxt').innerText = text;
  const card = document.getElementById('resCard');
  card.classList.add('on');

  const wv = document.getElementById('waves');
  if (wv) wv.classList.add('on');

  // stop whatever is currently playing so voices never overlap/repeat
  if (currentAudio) {
    try { currentAudio.pause(); currentAudio.currentTime = 0; } catch(e){}
    currentAudio = null;
  }
  if (window.speechSynthesis) window.speechSynthesis.cancel();

  fetch('/.netlify/functions/tts', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ text, voiceId })
  })
  .then(res => {
    if (!res.ok) throw new Error('TTS proxy error: ' + res.status);
    return res.json();
  })
  .then(data => {
    if (!data.audio) throw new Error('No audio returned');
    const byteChars = atob(data.audio);
    const byteNums = new Array(byteChars.length);
    for (let i = 0; i < byteChars.length; i++) byteNums[i] = byteChars.charCodeAt(i);
    const byteArray = new Uint8Array(byteNums);
    const blob = new Blob([byteArray], { type: 'audio/mpeg' });
    const url = URL.createObjectURL(blob);
    const audio = new Audio(url);
    audio.playbackRate = currentGender === 'female' ? 1.0 : 0.97;
    currentAudio = audio;

    audio.onended = () => {
      URL.revokeObjectURL(url);
      if (currentAudio === audio) currentAudio = null;
      if (wv) wv.classList.remove('on');
      setTimeout(() => card.classList.remove('on'), 1500);
    };

    audio.onerror = () => {
      if (currentAudio === audio) currentAudio = null;
      if (wv) wv.classList.remove('on');
      speakFallback(text, lang); // robotic browser voice, still gender-aware
    };

    audio.play().catch(() => {
      if (currentAudio === audio) currentAudio = null;
      if (wv) wv.classList.remove('on');
      speakFallback(text, lang);
    });
  })
  .catch(err => {
    console.warn('ElevenLabs proxy failed:', err.message);
    if (wv) wv.classList.remove('on');
    speakFallback(text, lang); // robotic browser voice, still gender-aware
  });
}

// Browser TTS fallback — agar ElevenLabs fail ho
function speakFallback(text, lang) {
  if (!('speechSynthesis' in window)) return;
  lang = lang || curLang;
  window.speechSynthesis.cancel();

  const card = document.getElementById('resCard');
  card.classList.add('on');

  const raw = text.split(/(?<=[.!?।])\s+/);
  const chunks = [];
  let cur = '';
  raw.forEach(s => {
    if ((cur + ' ' + s).trim().length <= 200) {
      cur = (cur + ' ' + s).trim();
    } else {
      if (cur) chunks.push(cur);
      cur = s;
    }
  });
  if (cur) chunks.push(cur);

  let i = 0;
  function nextChunk() {
    if (i >= chunks.length) {
      setTimeout(() => card.classList.remove('on'), 1500);
      return;
    }
    const utt = new SpeechSynthesisUtterance(chunks[i]);
    utt.lang = lang;
    utt.volume = 1;
    const voices = window.speechSynthesis.getVoices();
    let picked = null;
    if (currentGender === 'female') {
      picked = voices.find(v => v.lang === 'hi-IN')
            || voices.find(v => v.lang === 'en-IN');
    } else {
      picked = voices.find(v => v.lang === 'hi-IN')
            || voices.find(v => v.lang === 'en-IN');
    }
    if (picked) utt.voice = picked;
    utt.pitch = currentGender === 'female' ? 1.1 : 0.9;
    utt.rate = 0.88;
    utt.onend = () => { i++; setTimeout(nextChunk, 80); };
    utt.onerror = () => { i++; setTimeout(nextChunk, 80); };
    window.speechSynthesis.speak(utt);
  }
  setTimeout(nextChunk, 150);
}


